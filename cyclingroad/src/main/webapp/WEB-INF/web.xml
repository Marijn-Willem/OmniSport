<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>

  <listener>
    <listener-class>com.sports.web.init.ContextInit</listener-class>
  </listener>

  <context-param>
    <param-name>welcome-file</param-name>
    <param-value>Welcome</param-value>
  </context-param>

  <welcome-file-list>
    <welcome-file>servlet</welcome-file>
  </welcome-file-list>

  <servlet>
    <servlet-name>EntryServlet</servlet-name>
    <servlet-class>com.sportservlet.EntryServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>EntryServlet</servlet-name>
    <url-pattern>/servlet/*</url-pattern>
  </servlet-mapping>

</web-app>
